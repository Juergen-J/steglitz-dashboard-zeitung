# Profil für eine:n Schüler:in. Kopieren nach profiles/<name>.env, z. B. profiles/anna.env
# Der Dateiname (anna) ist der Profilname:  uv run zeitung -s anna

DASHBOARD_EMAIL=vorname.nachname@mail.gymnasiumsteglitz.de
# Name in der Zeitung (leer = aus der E-Mail)
STUDENT_NAME=
# Postfach, in dem der Anmeldecode ankommt. IMAP_USER leer = DASHBOARD_EMAIL
IMAP_USER=
IMAP_PASSWORD=
# Fächer ausblenden (Komma-getrennt)
HIDE_SUBJECTS=

# Optional, überschreibt die Werte aus .env:
# COMIC_STYLE=manga
# NEWSPAPER_TITLE=Der Anna-Anzeiger
# PRINTER=
