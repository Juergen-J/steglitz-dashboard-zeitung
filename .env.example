# ============================================================
#  Die Morgen-Posaune – gemeinsame Einstellungen
#  Kopieren nach .env:   cp .env.example .env
#  Persönliche Daten je Kind gehören in profiles/<name>.env
#  (Vorlage: profiles/beispiel.env.example)
# ============================================================

# --- Dashboard ---
DASHBOARD_URL=https://dashboard.gymnasiumsteglitz.de

# --- Mailserver, auf dem die Anmeldecodes ankommen ---
IMAP_HOST=imap.ionos.de
IMAP_PORT=993
IMAP_FOLDER=INBOX
# Code-Mail nach erfolgreichem Login löschen (true/false)
IMAP_DELETE_CODE_MAIL=false

# --- Zeitung ---
NEWSPAPER_TITLE=Die Morgen-Posaune
# abend  = nach der Schule für den nächsten Schultag (Standard)
# morgen = morgens für heute (ab NEXT_DAY_AFTER_HOUR Uhr für den nächsten Schultag)
EDITION=abend
NEXT_DAY_AFTER_HOUR=14
# Stil: classic | manga | noir | pop | auto (jeden Tag ein anderer)
COMIC_STYLE=auto
# Bei auto nur aus diesen Stilen wählen (leer = alle), z. B. classic,pop
COMIC_STYLES=
# Maskottchen: auto (wechselt täglich) | owl | robot | cat | dino
MASCOT=auto
# Tägliche Abwechslung (Kopf, Hintergrund, Accessoires, Extra-Kästen)
VARIETY=true

# --- Drucker ---
# leer = System-Standarddrucker (siehe: lpstat -d)
PRINTER=
PRINT_COLOR=true

# --- Filter ---
# Termine (Regex), die nicht erscheinen sollen. Leer = Standardliste
# (Fachkonferenz, Klassenteamsitzung, F(B)L, Gesamtkonferenz, …)
EVENT_EXCLUDE=

# --- KI-Inhalte (optional, OpenAI) ---
# Frische Witze/Rätsel/Fakten/Vokabeln einmal pro Tag.
# Ohne Key oder bei Fehlern werden die eingebauten Listen benutzt.
OPENAI_API_KEY=
# Modelle der Reihe nach – geht das erste nicht, wird das nächste probiert
OPENAI_MODEL=gpt-6-astra,gpt-5.4-mini
# auto = an, wenn ein Key gesetzt ist | false = aus
AI_CONTENT=auto

# --- Nur wenn du KEINE Profile benutzt (ein einzelnes Kind direkt in .env) ---
# DASHBOARD_EMAIL=vorname.nachname@mail.gymnasiumsteglitz.de
# STUDENT_NAME=
# IMAP_USER=
# IMAP_PASSWORD=
# HIDE_SUBJECTS=
